# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---------- 模型（462MB，用 tools/download_model.bat 获取）----------
models/

# ---------- 构建产物 ----------
build*/
dist/
release/
*.spec

# ---------- 探测输出（运行时生成）----------
rc_probe/*
!rc_probe/*.py
!rc_probe/*.mjs

# ---------- 本地数据 ----------
.workbuddy-ai/
*.log
vibe_images/

# 映射页自动保存的备份/临时文件
profiles.json.bak
profiles.json.tmp

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- native Qt SDK / build ----------
native/.qt/
native/build/

# ---------- native third-party (sherpa-onnx prebuilt) ----------
native/third_party/

# ---------- ZCode 工作区 ----------
.zcode/

# ---------- OpenSquilla 运行时状态（附件缓存等，桥本体在 plugins/opensquilla-bridge）----------
.opensquilla/

# ---------- 主题生成候选帧（人工挑选素材，不入库）----------
themes-candidate/

# ---------- 背景重绘/浅色生成的临时 scratch（对比图、掩膜、备份、脚本）----------
tmp_bg_fix/

# ---------- WebView2 原型：从 nuget 解出的 SDK（头 + loader，不入库）----------
native/.webview2-sdk/
