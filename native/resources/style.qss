* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QWidget#root {
    background: @bg@;
}

QWidget#header {
    background: transparent;
}

QLabel#brandLogo {
    color: @on.accent@;
    font-size: 11px;
    font-weight: 800;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @accent@, stop:1 @accent.2@);
    border-radius: 6px;
}

QLabel#brand {
    color: @text@;
    font-size: 14px;
    font-weight: 700;
}

QLabel#tag {
    color: @accent.text@;
    font-size: 9px;
    font-weight: 600;
    background: @a28@;
    border: 1px solid @a80@;
    border-radius: 8px;
    padding: 2px 7px;
}

QLabel#muted {
    color: @muted@;
    font-size: 11px;
}

QLabel#voiceBox {
    color: @muted.2@;
    font-size: 11px;
    background: @w7@;
    border: 1px solid @w12@;
    border-radius: 10px;
    padding: 8px 10px;
}

QLabel#dot {
    background: @line@;
    border-radius: 3px;
}

QFrame#card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 @card.bg@, stop:1 @card.bg2@);
    border: 1px solid @w18@;
    border-radius: 16px;
}

QLabel#cardTitle {
    color: @muted@;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#badge {
    color: @muted@;
    font-size: 10px;
    background: @w10@;
    border: 1px solid @w16@;
    border-radius: 8px;
    padding: 2px 8px;
}

QPushButton#ghost {
    color: @text.dim@;
    font-size: 11px;
    background: @w6@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 5px 10px;
}

QPushButton#ghost:hover {
    background: @w12@;
}

QPushButton#ghost:disabled {
    color: @faint@;
    background: transparent;
    border: 1px solid @w10@;
}

QPushButton#ghostText {
    color: @muted@;
    font-size: 11px;
    background: transparent;
    border: none;
}

QPushButton#ghostText:disabled {
    color: @faint.2@;
}

QToolButton#winBtn {
    color: @muted@;
    font-size: 13px;
    border: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#winBtn:hover {
    color: @text@;
    background: @w14@;
}

QToolButton#closeBtn {
    color: @muted@;
    font-size: 12px;
    border: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#closeBtn:hover {
    color: @on.accent@;
    background: @danger@;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    color: @muted@;
    background: transparent;
    padding: 7px 14px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: @text@;
    background: @a26@;
    border: 1px solid @a64@;
}

QTabBar::tab:hover {
    color: @text.dim@;
    background: @w8@;
}

QTabWidget QWidget {
    background: transparent;
}

QTableWidget {
    background: transparent;
    border: none;
    color: @text.soft@;
    font-size: 11px;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid @w8@;
}

QHeaderView::section {
    color: @muted.2@;
    background: transparent;
    border: none;
    border-bottom: 1px solid @w16@;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 8px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel#secTitle {
    color: @text@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#secBody {
    color: @text.body@;
    font-size: 12px;
}

QMenu {
    background: @raised@;
    color: @text@;
    border: 1px solid @w26@;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    font-size: 11.5px;
}

QMenu::item:selected {
    background: @a70@;
}

QMessageBox {
    background: @msgbox.bg@;
    color: @text@;
}

QMessageBox QLabel {
    color: @text@;
    font-size: 12px;
}


QComboBox {
    color: @text.soft@;
    background: @w7@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
}

QComboBox:hover {
    background: @w11@;
}

QComboBox QAbstractItemView {
    background: @raised@;
    color: @text@;
    border: 1px solid @w26@;
    selection-background-color: @a70@;
}

QPushButton#ghostSmall {
    color: @text.dim@;
    font-size: 11px;
    background: @w6@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 5px 10px;
}

QPushButton#ghostSmall:hover {
    background: @w12@;
}

QPushButton#ghostSmall:disabled {
    color: @faint@;
    background: transparent;
    border: 1px solid @w10@;
}

QLabel#sceneName {
    color: @text@;
    font-size: 12.5px;
    font-weight: 600;
}

QLabel#sceneRule {
    color: @muted.2@;
    font-size: 10.5px;
}

QLabel#mapHead {
    color: @muted.2@;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#mapGroup {
    color: @muted@;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1px;
}

QFrame#mapHair {
    background: @w10@;
    border: none;
}

QFrame#mapKeyRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
}

QFrame#mapKeyRow:hover {
    background: @w10@;
}

QFrame#mapKeyRow[sel="true"] {
    background: @a24@;
    border: 1px solid @a72@;
}

QLabel#mapChip {
    color: @text@;
    font-size: 9.5px;
    font-weight: 700;
    background: @w14@;
    border: 1px solid @w20@;
    border-radius: 6px;
}

QLabel#mapKeyName {
    color: @text.soft@;
    font-size: 12px;
    font-weight: 600;
}

QFrame#mapCell {
    background: @w4@;
    border: 1px solid @w10@;
    border-radius: 7px;
}

QFrame#mapCell[ro="true"] {
    background: transparent;
    border: 1px solid transparent;
}

QFrame#mapCell[ro="true"]:hover {
    background: transparent;
    border: 1px solid transparent;
}

QFrame#mapCell:hover {
    background: @a16@;
    border: 1px solid @a110@;
}

QLabel#mapCellTitle {
    color: @text.soft@;
    font-size: 11px;
    font-weight: 600;
}

QLabel#mapCellEffect {
    color: @ghost@;
    font-size: 9.5px;
}

QLabel#mapCellDash {
    color: @faint@;
    font-size: 11px;
}

QLabel#mapCellChev {
    color: @line@;
    font-size: 10px;
}

QFrame#mapCell:hover QLabel#mapCellChev {
    color: @accent.text@;
}

QFrame#mapKeyRow[sel="true"] QLabel#mapCellEffect {
    color: @muted@;
}

QFrame#mapKeyRow[sel="true"] QLabel#mapCellChev {
    color: @muted@;
}

QWidget#appHolder {
    background: transparent;
}

QWidget#appRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QWidget#appRow:hover {
    background: @w8@;
    border: 1px solid @w14@;
}

QLabel#appName {
    color: @text.soft@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#appState {
    color: @ghost@;
    font-size: 10.5px;
}

QLabel#appStateMiss {
    color: @warn@;
    font-size: 10.5px;
}

QLabel#mapFoot {
    color: @muted.2@;
    font-size: 10px;
}

QDialog#comboCapture {
    background: @card.bg@;
    border: 1px solid @w24@;
    border-radius: 10px;
}

QDialog#voiceDialog {
    background: @dialog.bg@;
    border: 1px solid @w24@;
    border-radius: 12px;
}

QDialog#voiceDialog QLabel {
    color: @text.dim@;
    font-size: 11px;
}

QDialog#voiceDialog QLineEdit {
    color: @text.soft@;
    background: @w7@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
    selection-background-color: @a120@;
}

QDialog#voiceDialog QCheckBox {
    color: @text.dim@;
    font-size: 11px;
    spacing: 7px;
}

QDialog#voiceDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @w40@;
    border-radius: 4px;
    background: @w7@;
}

QDialog#voiceDialog QCheckBox::indicator:checked {
    background: @accent@;
    border-color: @accent@;
}

QLabel#dialogNote {
    color: @muted.2@;
    font-size: 10px;
}

QDialog#guideDialog {
    background: @dialog.bg@;
    border: 1px solid @w24@;
    border-radius: 12px;
}

QLabel#guideImage {
    background: @guide.image.bg@;
    border: 1px solid @w26@;
    border-radius: 12px;
}

QLabel#kbd {
    color: @text.soft@;
    font-size: 11px;
    font-weight: 600;
    background: @w14@;
    border: 1px solid @w20@;
    border-radius: 6px;
    padding: 3px 7px;
}

QPushButton#guideLink {
    background: transparent;
    border: none;
    color: @accent@;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 2px;
}

QPushButton#guideLink:hover {
    color: @accent.link@;
}

QLabel#toast {
    background: transparent;
    border: none;
    color: @text@;
    font-size: 12px;
    padding: 9px 16px;
}

QLabel#captureTitle {
    color: @text@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#captureCombo {
    color: @accent@;
    font-size: 15px;
    font-weight: 700;
    background: @w10@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 8px 12px;
}

QLabel#captureHint {
    color: @muted@;
    font-size: 10px;
}


QPushButton#primary {
    color: @on.accent@;
    font-size: 12px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent@, stop:1 @accent.2@);
    border: none;
    border-radius: 10px;
    padding: 9px 0;
}

QPushButton#primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent.hover@, stop:1 @accent2.hover@);
}

QListWidget#logList {
    background: transparent;
    border: none;
    color: @text.dim@;
    font-size: 11px;
}

QListWidget#logList::item {
    padding: 5px 6px;
    border-radius: 6px;
}

QListWidget#logList::item:hover {
    background: @w6@;
}

QToolTip {
    color: @text@;
    background: @raised@;
    border: 1px solid @w26@;
}


QPushButton#choiceCard {
    background: @card.bg@;
    border: 1px solid @w22@;
    border-radius: 14px;
    color: @text@;
    font-size: 16px;
    padding: 18px;
}

QPushButton#choiceCard:hover {
    border-color: @a150@;
    background: @raised@;
}

/* ---------- 语音主界面（无遥控器简洁版） ---------- */

QWidget#voiceWindow {
    background: @bg@;
}

QWidget#voiceHeader {
    background: @card.bg@;
    border-bottom: 1px solid @w18@;
}

QPushButton#micButton {
    background: transparent;
    border: none;
}

QLabel#voiceStateLine {
    color: @text.soft@;
    font-size: 13px;
}

QLabel#voiceTranscript {
    background: @card.bg@;
    border: 1px solid @w18@;
    border-radius: 12px;
    padding: 10px;
    color: @text@;
    font-size: 14px;
}

QListWidget#voiceHistory {
    background: transparent;
    color: @text.dim@;
    font-size: 12px;
}

QListWidget#voiceHistory::item {
    padding: 6px 8px;
    border-radius: 8px;
}

QListWidget#voiceHistory::item:hover {
    background: @a36@;
}

QListWidget#voiceHistory::item:pressed {
    background: @a58@;
}

/* ---------- 语音桌宠 ---------- */

QWidget#petCard {
    background: @dialog.bg@;
    border: 1px solid @w26@;
    border-radius: 12px;
}

QLabel#petStatus {
    background: transparent;
    color: @text@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#petDetail {
    background: transparent;
    color: @muted@;
    font-size: 11px;
}

QPushButton#petMode {
    background: @w8@;
    border: 1px solid @w16@;
    border-radius: 8px;
    color: @muted@;
    font-size: 11px;
    padding: 4px 2px;
}

QPushButton#petMode:checked {
    background: @a58@;
    border: 1px solid @a130@;
    color: @text@;
}

QLabel#petTranscript {
    background: @card.bg@;
    border: 1px solid @w14@;
    border-radius: 8px;
    color: @text@;
    font-size: 11px;
    padding: 6px 8px;
}

QLabel#petBubble {
    background: @bubble.bg@;
    border: 1px solid @w30@;
    border-radius: 10px;
    color: @text@;
    font-size: 12px;
}

QPushButton#petMode {
    font-size: 10px;
    padding: 4px 0;
}
