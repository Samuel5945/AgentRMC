* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QWidget#root {
    background: @bg@;
}

QWidget#header {
    background: transparent;
}

QLabel#brandLogo {
    color: @on.accent@;
    font-size: 11px;
    font-weight: 800;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @accent@, stop:1 @accent.2@);
    border-radius: 6px;
}

QLabel#brand {
    color: @text@;
    font-size: 14px;
    font-weight: 700;
}

QLabel#tag {
    color: @accent.text@;
    font-size: 9px;
    font-weight: 600;
    background: @a28@;
    border: 1px solid @a80@;
    border-radius: 8px;
    padding: 2px 7px;
}

QLabel#muted {
    color: @muted@;
    font-size: 11px;
}

QLabel#voiceBox {
    color: @muted.2@;
    font-size: 11px;
    background: @w7@;
    border: 1px solid @w12@;
    border-radius: 10px;
    padding: 8px 10px;
}

QLabel#dot {
    background: @line@;
    border-radius: 3px;
}

QFrame#card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 @card.bg@, stop:1 @card.bg2@);
    border: 1px solid @w18@;
    border-radius: 16px;
}

QLabel#cardTitle {
    color: @muted@;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ---------- 主界面：监听状态胶囊 / 待办页 ---------- */

QPushButton#statusPill {
    background: @w6@;
    border: 1px solid @w14@;
    border-radius: 10px;
}

QPushButton#statusPill:hover {
    background: @w10@;
}

QLabel#statusText {
    color: @muted@;
    font-size: 11px;
}

QLabel#workCount {
    color: @text@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#workHealth {
    color: @muted@;
    font-size: 10.5px;
}

QLabel#workHint {
    color: @muted.2@;
    font-size: 10.5px;
}

QListWidget#workList {
    background: transparent;
    border: none;
    outline: none;
}

QLabel#emptyTitle {
    color: @text.soft@;
    font-size: 14px;
    font-weight: 600;
}

QLabel#emptyHint {
    color: @muted@;
    font-size: 11px;
}

QPushButton#primarySmall {
    color: @on.accent@;
    font-size: 11px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent@, stop:1 @accent.2@);
    border: none;
    border-radius: 8px;
    padding: 5px 12px;
}

QPushButton#primarySmall:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent.hover@, stop:1 @accent2.hover@);
}

QPushButton#primarySmall:disabled {
    color: @faint@;
    background: @w8@;
}

/* 隐藏滚动条（用户 2026-11-03：所有地方都不要明显滚动条）：
   宽高 0 不占位，滚轮/触控板照常滚。 */
QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @w30@;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: @w40@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: @w30@;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: @w40@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QLabel#badge {
    color: @muted@;
    font-size: 10px;
    background: @w10@;
    border: 1px solid @w16@;
    border-radius: 8px;
    padding: 2px 8px;
}

QPushButton#ghost {
    color: @text.dim@;
    font-size: 11px;
    background: @w6@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 5px 10px;
}

QPushButton#ghost:hover {
    background: @w12@;
}

QPushButton#ghost:disabled {
    color: @faint@;
    background: transparent;
    border: 1px solid @w10@;
}

QPushButton#ghostText {
    color: @muted@;
    font-size: 11px;
    background: transparent;
    border: none;
}

QPushButton#ghostText:disabled {
    color: @faint.2@;
}

QToolButton#winBtn {
    color: @muted@;
    font-size: 13px;
    border: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#winBtn:hover {
    color: @text@;
    background: @w14@;
}

QToolButton#closeBtn {
    color: @muted@;
    font-size: 12px;
    border: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#closeBtn:hover {
    color: @on.accent@;
    background: @danger@;
}

QTabWidget::pane {
    border: none;
    background: transparent;
    /* 页签和内容之间留出呼吸：之前页签直接压在卡片上沿。 */
    margin-top: 10px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    color: @muted@;
    background: transparent;
    padding: 7px 14px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: @text@;
    background: @a26@;
    border: 1px solid @a64@;
}

QTabBar::tab:hover {
    color: @text.dim@;
    background: @w8@;
}

QTabWidget QWidget {
    background: transparent;
}

QTableWidget {
    background: transparent;
    border: none;
    color: @text.soft@;
    font-size: 11px;
    /* 不设这一项会退回系统浅色调色板：隔行变成白底白字。 */
    alternate-background-color: @w6@;
}

QTableWidget::item:selected {
    background: @a36@;
    color: @text@;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid @w8@;
}

QHeaderView::section {
    color: @muted.2@;
    background: transparent;
    border: none;
    border-bottom: 1px solid @w16@;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 8px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel#secTitle {
    color: @text@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#secBody {
    color: @text.body@;
    font-size: 12px;
}

QMenu {
    background: @raised@;
    color: @text@;
    border: 1px solid @w26@;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    font-size: 11.5px;
}

QMenu::item:selected {
    background: @a70@;
}

QMessageBox {
    background: @msgbox.bg@;
    color: @text@;
}

QMessageBox QLabel {
    color: @text@;
    font-size: 12px;
}


QComboBox {
    color: @text.soft@;
    background: @w7@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
}

QComboBox:hover {
    background: @w11@;
}

QComboBox QAbstractItemView {
    background: @raised@;
    color: @text@;
    border: 1px solid @w26@;
    selection-background-color: @a70@;
}

QPushButton#ghostSmall {
    color: @text.dim@;
    font-size: 11px;
    background: @w6@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 5px 10px;
}

QPushButton#ghostSmall:hover {
    background: @w12@;
}

QPushButton#ghostSmall:disabled {
    color: @faint@;
    background: transparent;
    border: 1px solid @w10@;
}

QLabel#sceneName {
    color: @text@;
    font-size: 12.5px;
    font-weight: 600;
}

QLabel#sceneRule {
    color: @muted.2@;
    font-size: 10.5px;
}

QLabel#mapHead {
    color: @muted.2@;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#mapGroup {
    color: @muted@;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1px;
}

QFrame#mapHair {
    background: @w10@;
    border: none;
}

QFrame#mapKeyRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
}

QFrame#mapKeyRow:hover {
    background: @w10@;
}

QFrame#mapKeyRow[sel="true"] {
    background: @a24@;
    border: 1px solid @a72@;
}

QLabel#mapChip {
    color: @text@;
    font-size: 9.5px;
    font-weight: 700;
    background: @w14@;
    border: 1px solid @w20@;
    border-radius: 6px;
}

QLabel#mapKeyName {
    color: @text.soft@;
    font-size: 12px;
    font-weight: 600;
}

QFrame#mapCell {
    background: @w4@;
    border: 1px solid @w10@;
    border-radius: 7px;
}

QFrame#mapCell[ro="true"] {
    background: transparent;
    border: 1px solid transparent;
}

QFrame#mapCell[ro="true"]:hover {
    background: transparent;
    border: 1px solid transparent;
}

QFrame#mapCell:hover {
    background: @a16@;
    border: 1px solid @a110@;
}

QLabel#mapCellTitle {
    color: @text.soft@;
    font-size: 11px;
    font-weight: 600;
}

QLabel#mapCellEffect {
    color: @ghost@;
    font-size: 9.5px;
}

QLabel#mapCellDash {
    color: @faint@;
    font-size: 11px;
}

QLabel#mapCellChev {
    color: @line@;
    font-size: 10px;
}

QFrame#mapCell:hover QLabel#mapCellChev {
    color: @accent.text@;
}

QFrame#mapKeyRow[sel="true"] QLabel#mapCellEffect {
    color: @muted@;
}

QFrame#mapKeyRow[sel="true"] QLabel#mapCellChev {
    color: @muted@;
}

QWidget#appHolder {
    background: transparent;
}

QWidget#appRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QWidget#appRow:hover {
    background: @w8@;
    border: 1px solid @w14@;
}

QLabel#appName {
    color: @text.soft@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#appState {
    color: @ghost@;
    font-size: 10.5px;
}

QLabel#appStateMiss {
    color: @warn@;
    font-size: 10.5px;
}

QLabel#mapFoot {
    color: @muted.2@;
    font-size: 10px;
}

QDialog#comboCapture {
    background: @card.bg@;
    border: 1px solid @w24@;
    border-radius: 10px;
}

QDialog#voiceDialog {
    background: @dialog.bg@;
    border: 1px solid @w24@;
    border-radius: 12px;
}

QDialog#voiceDialog QLabel {
    color: @text.dim@;
    font-size: 11px;
}

QDialog#voiceDialog QLineEdit {
    color: @text.soft@;
    background: @w7@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
    selection-background-color: @a120@;
}

/* 输入框全局跟主题：此前只有 voiceDialog 有规则，语音主界面打字行
   在深色下白框黑底、placeholder 看不见（2026-11-03 真机）。 */
QLineEdit {
    color: @text@;
    background: @card.bg@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 5px 8px;
    selection-background-color: @a120@;
}

QLineEdit:focus {
    border: 1px solid @accent@;
}

QDialog#voiceDialog QCheckBox {
    color: @text.dim@;
    font-size: 11px;
    spacing: 7px;
}

QDialog#voiceDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @w40@;
    border-radius: 4px;
    background: @w7@;
}

QDialog#voiceDialog QCheckBox::indicator:checked {
    background: @accent@;
    border-color: @accent@;
}

QLabel#dialogNote {
    color: @muted.2@;
    font-size: 10px;
}

QDialog#guideDialog {
    background: @dialog.bg@;
    border: 1px solid @w24@;
    border-radius: 12px;
}

QLabel#guideImage {
    background: @guide.image.bg@;
    border: 1px solid @w26@;
    border-radius: 12px;
}

QLabel#kbd {
    color: @text.soft@;
    font-size: 11px;
    font-weight: 600;
    background: @w14@;
    border: 1px solid @w20@;
    border-radius: 6px;
    padding: 3px 7px;
}

QPushButton#guideLink {
    background: transparent;
    border: none;
    color: @accent@;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 2px;
}

QPushButton#guideLink:hover {
    color: @accent.link@;
}

QLabel#toast {
    background: transparent;
    border: none;
    color: @text@;
    font-size: 12px;
    padding: 9px 16px;
}

QLabel#captureTitle {
    color: @text@;
    font-size: 13px;
    font-weight: 700;
}

QLabel#captureCombo {
    color: @accent@;
    font-size: 15px;
    font-weight: 700;
    background: @w10@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 8px 12px;
}

QLabel#captureHint {
    color: @muted@;
    font-size: 10px;
}


QPushButton#primary {
    color: @on.accent@;
    font-size: 12px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent@, stop:1 @accent.2@);
    border: none;
    border-radius: 10px;
    padding: 9px 0;
}

QPushButton#primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent.hover@, stop:1 @accent2.hover@);
}

QListWidget#logList {
    background: transparent;
    border: none;
    color: @text.dim@;
    font-size: 11px;
}

QListWidget#logList::item {
    padding: 5px 6px;
    border-radius: 6px;
}

QListWidget#logList::item:hover {
    background: @w6@;
}

QToolTip {
    color: @text@;
    background: @raised@;
    border: 1px solid @w26@;
}


QPushButton#choiceCard {
    background: @card.bg@;
    border: 1px solid @w22@;
    border-radius: 14px;
    color: @text@;
    font-size: 16px;
    padding: 18px;
}

/* 卡片正文改成 QLabel 之后单独给字号：标题大一点、说明小一点并允许换行，
   否则长描述会被卡片边缘裁掉两头。 */
QLabel#choiceCardTitle {
    font-size: 17px;
    font-weight: 600;
    color: @text@;
}

QLabel#choiceCardDesc {
    font-size: 14px;
    color: @muted@;
}

QPushButton#choiceCard:hover {
    border-color: @a150@;
    background: @raised@;
}

/* ---------- 主题与外观面板 ---------- */

QDialog#themeDialog {
    background: @dialog.bg@;
    border: 1px solid @w24@;
    border-radius: 12px;
}

QDialog#themeDialog QLabel {
    color: @text.dim@;
    font-size: 11px;
}

QListWidget#themeList, QListWidget#characterList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#themeList::item, QListWidget#characterList::item {
    color: @muted@;
    font-size: 10.5px;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 4px 2px;
}

QListWidget#themeList::item:hover, QListWidget#characterList::item:hover {
    background: @w8@;
    color: @text.dim@;
}

QListWidget#themeList::item:selected, QListWidget#characterList::item:selected {
    background: @a26@;
    border: 1px solid @a64@;
    color: @text@;
}

QSlider::groove:horizontal {
    height: 4px;
    background: @w14@;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent@, stop:1 @accent.2@);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
    background: @text@;
}

QSlider::handle:horizontal:hover {
    background: @accent.text@;
}

/* 配色模式：浅色 / 深色 / 跟随系统 三选一 */
QPushButton#schemeOption {
    color: @text.dim@;
    font-size: 11px;
    background: @w6@;
    border: 1px solid @w18@;
    border-radius: 8px;
    padding: 6px 10px;
}

QPushButton#schemeOption:hover {
    background: @w12@;
}

QPushButton#schemeOption:checked {
    color: @text@;
    background: @a26@;
    border: 1px solid @a64@;
}

QPushButton#schemeOption:disabled {
    color: @faint@;
    background: transparent;
    border: 1px solid @w10@;
}

/* ---------- 语音主界面（无遥控器简洁版） ---------- */

QWidget#voiceWindow {
    background: @bg@;
}

/* 嵌入主窗左栏的语音页：与 QFrame#card 完全相同的表面（半透明渐变卡），
   美术主题下透出背景图；页眉透明只留分隔线。 */
QWidget#voiceWindowEmbedded {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 @card.bg@, stop:1 @card.bg2@);
    border: 1px solid @w18@;
    border-radius: 16px;
}

QWidget#voiceHeaderEmbedded {
    background: transparent;
    border-bottom: 1px solid @w18@;
}

QWidget#voiceHeader {
    background: @card.bg@;
    border-bottom: 1px solid @w18@;
}

/* 底部控制区：嵌入态页面本身已是卡片，dock 透明不套娃；
   独立态铺同款卡片渐变，灰字/控件不直接坐在亮插画上。 */
QWidget#voiceDock {
    background: transparent;
    border: none;
}

QWidget#voiceWindow QWidget#voiceDock {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 @card.bg@, stop:1 @card.bg2@);
    border: 1px solid @w18@;
    border-radius: 12px;
}

QLabel#voiceStateLine {
    color: @text.soft@;
    font-size: 13px;
}

QLabel#voiceTranscript {
    background: @card.bg@;
    border: 1px solid @w18@;
    border-radius: 12px;
    padding: 10px;
    color: @text@;
    font-size: 14px;
}

QListWidget#voiceHistory {
    background: transparent;
    color: @text.dim@;
    font-size: 12px;
}

QListWidget#voiceHistory::item {
    padding: 6px 8px;
    border-radius: 8px;
}

QListWidget#voiceHistory::item:hover {
    background: @a36@;
}

QListWidget#voiceHistory::item:pressed {
    background: @a58@;
}

/* ---------- 语音桌宠 ---------- */

QWidget#petCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 @bubble.bg@, stop:1 @bubble.bg2@);
    border: 1px solid @bubble.border@;
    border-radius: 16px;
}

QLabel#petStatus {
    background: transparent;
    color: @text@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#petDetail {
    background: transparent;
    color: @muted@;
    font-size: 11px;
}

/* 卡内下拉（顶行识别模型 + 中部宿主/会话）统一紧凑圆角，跟卡片同族。 */
#petCard QComboBox {
    background: @w8@;
    border: 1px solid @w16@;
    border-radius: 8px;
    color: @text@;
    font-size: 11px;
    padding: 4px 6px;
}
#petCard QComboBox::drop-down {
    border: none;
    width: 16px;
}
#petCard QComboBox QAbstractItemView {
    background: @dialog.bg@;
    color: @text@;
    selection-background-color: @a58@;
    border: 1px solid @w16@;
}

QLabel#petTranscript {
    background: @card.bg@;
    border: 1px solid @w14@;
    border-radius: 8px;
    color: @text@;
    font-size: 11px;
    padding: 6px 8px;
}

/* 气泡底/描边由 PetBubble::paintEvent 自绘（渐变+鲸鱼尾）；QSS 里再设 background
   会把尾巴 margin 区也涂成方块底，只留字色字号。 */
QLabel#petBubble {
    color: @text@;
    font-size: 12px;
}
