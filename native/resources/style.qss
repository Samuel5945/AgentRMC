* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QWidget#root {
    background: #0b0e14;
}

QWidget#header {
    background: transparent;
}

QLabel#brandLogo {
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #4f8cff, stop:1 #7c5cff);
    border-radius: 6px;
}

QLabel#brand {
    color: #e6edf3;
    font-size: 14px;
    font-weight: 700;
}

QLabel#tag {
    color: #9ec1ff;
    font-size: 9px;
    font-weight: 600;
    background: rgba(79, 140, 255, 28);
    border: 1px solid rgba(79, 140, 255, 80);
    border-radius: 8px;
    padding: 2px 7px;
}

QLabel#muted {
    color: #8b949e;
    font-size: 11px;
}

QLabel#voiceBox {
    color: #5b6472;
    font-size: 11px;
    background: rgba(255, 255, 255, 7);
    border: 1px solid rgba(255, 255, 255, 12);
    border-radius: 10px;
    padding: 8px 10px;
}

QLabel#dot {
    background: #4a5568;
    border-radius: 3px;
}

QFrame#card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #121722, stop:1 #161d2a);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 16px;
}

QLabel#cardTitle {
    color: #8b949e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#badge {
    color: #8b949e;
    font-size: 10px;
    background: rgba(255, 255, 255, 10);
    border: 1px solid rgba(255, 255, 255, 16);
    border-radius: 8px;
    padding: 2px 8px;
}

QPushButton#ghost {
    color: #c9d1d9;
    font-size: 11px;
    background: rgba(255, 255, 255, 6);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 8px;
    padding: 5px 10px;
}

QPushButton#ghost:hover {
    background: rgba(255, 255, 255, 12);
}

QPushButton#ghost:disabled {
    color: #46505e;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 10);
}

QPushButton#ghostText {
    color: #8b949e;
    font-size: 11px;
    background: transparent;
    border: none;
}

QPushButton#ghostText:disabled {
    color: #3d4653;
}

QToolButton#winBtn {
    color: #8b949e;
    font-size: 13px;
    border: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#winBtn:hover {
    color: #e6edf3;
    background: rgba(255, 255, 255, 14);
}

QToolButton#closeBtn {
    color: #8b949e;
    font-size: 12px;
    border: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#closeBtn:hover {
    color: #ffffff;
    background: #e5484d;
}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    color: #8b949e;
    background: transparent;
    padding: 7px 14px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: #e6edf3;
    background: rgba(79, 140, 255, 26);
    border: 1px solid rgba(79, 140, 255, 64);
}

QTabBar::tab:hover {
    color: #c9d1d9;
    background: rgba(255, 255, 255, 8);
}

QTabWidget QWidget {
    background: transparent;
}

QTableWidget {
    background: transparent;
    border: none;
    color: #dbe4ee;
    font-size: 11px;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 8);
}

QHeaderView::section {
    color: #5b6472;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 16);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 8px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel#secTitle {
    color: #e6edf3;
    font-size: 13px;
    font-weight: 700;
}

QLabel#secBody {
    color: #b6c2cf;
    font-size: 12px;
}

QMenu {
    background: #161d2a;
    color: #e6edf3;
    border: 1px solid rgba(255, 255, 255, 26);
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    font-size: 11.5px;
}

QMenu::item:selected {
    background: rgba(79, 140, 255, 70);
}

QMessageBox {
    background: #121722;
    color: #e6edf3;
}

QMessageBox QLabel {
    color: #e6edf3;
    font-size: 12px;
}


QComboBox {
    color: #dbe4ee;
    background: rgba(255, 255, 255, 7);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
}

QComboBox:hover {
    background: rgba(255, 255, 255, 11);
}

QComboBox QAbstractItemView {
    background: #161d2a;
    color: #e6edf3;
    border: 1px solid rgba(255, 255, 255, 26);
    selection-background-color: rgba(79, 140, 255, 70);
}

QPushButton#ghostSmall {
    color: #c9d1d9;
    font-size: 11px;
    background: rgba(255, 255, 255, 6);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 8px;
    padding: 5px 10px;
}

QPushButton#ghostSmall:hover {
    background: rgba(255, 255, 255, 12);
}

QPushButton#ghostSmall:disabled {
    color: #46505e;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 10);
}

QLabel#sceneName {
    color: #e6edf3;
    font-size: 12.5px;
    font-weight: 600;
}

QLabel#sceneRule {
    color: #5b6472;
    font-size: 10.5px;
}

QLabel#mapHead {
    color: #5b6472;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#mapGroup {
    color: #8b949e;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1px;
}

QFrame#mapHair {
    background: rgba(255, 255, 255, 10);
    border: none;
}

QFrame#mapKeyRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
}

QFrame#mapKeyRow:hover {
    background: rgba(255, 255, 255, 10);
}

QFrame#mapKeyRow[sel="true"] {
    background: rgba(79, 140, 255, 24);
    border: 1px solid rgba(79, 140, 255, 72);
}

QLabel#mapChip {
    color: #e6edf3;
    font-size: 9.5px;
    font-weight: 700;
    background: rgba(255, 255, 255, 14);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 6px;
}

QLabel#mapKeyName {
    color: #dbe4ee;
    font-size: 12px;
    font-weight: 600;
}

QFrame#mapCell {
    background: rgba(255, 255, 255, 4);
    border: 1px solid rgba(255, 255, 255, 10);
    border-radius: 7px;
}

QFrame#mapCell[ro="true"] {
    background: transparent;
    border: 1px solid transparent;
}

QFrame#mapCell[ro="true"]:hover {
    background: transparent;
    border: 1px solid transparent;
}

QFrame#mapCell:hover {
    background: rgba(79, 140, 255, 16);
    border: 1px solid rgba(79, 140, 255, 110);
}

QLabel#mapCellTitle {
    color: #dbe4ee;
    font-size: 11px;
    font-weight: 600;
}

QLabel#mapCellEffect {
    color: #6b7684;
    font-size: 9.5px;
}

QLabel#mapCellDash {
    color: #46505e;
    font-size: 11px;
}

QLabel#mapCellChev {
    color: #4a5568;
    font-size: 10px;
}

QFrame#mapCell:hover QLabel#mapCellChev {
    color: #9ec1ff;
}

QFrame#mapKeyRow[sel="true"] QLabel#mapCellEffect {
    color: #8b949e;
}

QFrame#mapKeyRow[sel="true"] QLabel#mapCellChev {
    color: #8b949e;
}

QLabel#mapFoot {
    color: #5b6472;
    font-size: 10px;
}

QDialog#comboCapture {
    background: #121722;
    border: 1px solid rgba(255, 255, 255, 24);
    border-radius: 10px;
}

QDialog#voiceDialog {
    background: #0f141d;
    border: 1px solid rgba(255, 255, 255, 24);
    border-radius: 12px;
}

QDialog#voiceDialog QLabel {
    color: #c9d1d9;
    font-size: 11px;
}

QDialog#voiceDialog QLineEdit {
    color: #dbe4ee;
    background: rgba(255, 255, 255, 7);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
    selection-background-color: rgba(79, 140, 255, 120);
}

QDialog#voiceDialog QCheckBox {
    color: #c9d1d9;
    font-size: 11px;
    spacing: 7px;
}

QDialog#voiceDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 4px;
    background: rgba(255, 255, 255, 7);
}

QDialog#voiceDialog QCheckBox::indicator:checked {
    background: #4f8cff;
    border-color: #4f8cff;
}

QLabel#dialogNote {
    color: #5b6472;
    font-size: 10px;
}

QDialog#guideDialog {
    background: #0f141d;
    border: 1px solid rgba(255, 255, 255, 24);
    border-radius: 12px;
}

QLabel#guideImage {
    background: #05070c;
    border: 1px solid rgba(255, 255, 255, 26);
    border-radius: 12px;
}

QLabel#kbd {
    color: #dbe4ee;
    font-size: 11px;
    font-weight: 600;
    background: rgba(255, 255, 255, 14);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 6px;
    padding: 3px 7px;
}

QPushButton#guideLink {
    background: transparent;
    border: none;
    color: #4f8cff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 2px;
}

QPushButton#guideLink:hover {
    color: #7dabff;
}

QLabel#toast {
    background: transparent;
    border: none;
    color: #e6edf3;
    font-size: 12px;
    padding: 9px 16px;
}

QLabel#captureTitle {
    color: #e6edf3;
    font-size: 13px;
    font-weight: 700;
}

QLabel#captureCombo {
    color: #4f8cff;
    font-size: 15px;
    font-weight: 700;
    background: rgba(255, 255, 255, 10);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 8px;
    padding: 8px 12px;
}

QLabel#captureHint {
    color: #8b949e;
    font-size: 10px;
}


QPushButton#primary {
    color: white;
    font-size: 12px;
    font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4f8cff, stop:1 #7c5cff);
    border: none;
    border-radius: 10px;
    padding: 9px 0;
}

QPushButton#primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6299ff, stop:1 #8d70ff);
}

QListWidget#logList {
    background: transparent;
    border: none;
    color: #c9d1d9;
    font-size: 11px;
}

QListWidget#logList::item {
    padding: 5px 6px;
    border-radius: 6px;
}

QListWidget#logList::item:hover {
    background: rgba(255, 255, 255, 6);
}

QToolTip {
    color: #e6edf3;
    background: #161d2a;
    border: 1px solid rgba(255, 255, 255, 26);
}

