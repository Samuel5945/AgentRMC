{
  "name": "agentrmc-bridge",
  "displayName": "AgentRMC 桌宠联动",
  "version": "0.3.5",
  "description": "AgentRMC 桌宠联动（Qoder 国际版 / Qoder CN 通用）：等授权、等选方案、任务完成自动气泡 + 语音提醒（hooks，宿主自己认出自己是哪个变体），MCP 工具汇报进度、让桌宠说话、查桌宠状态。",
  "author": {
    "name": "AgentRMC"
  },
  "homepage": "https://github.com/AgentRMC/Agentrmc",
  "keywords": [
    "qoder-plugin",
    "agentrmc",
    "desktop-pet",
    "mcp",
    "hooks"
  ],
  "hooks": "./hooks-qoder/hooks.json",
  "mcpServers": {
    "agentrmc": {
      "command": "node",
      "args": [
        "${QODER_PLUGIN_ROOT}/mcp/server.js"
      ]
    }
  },
  "skills": "./skills"
}
