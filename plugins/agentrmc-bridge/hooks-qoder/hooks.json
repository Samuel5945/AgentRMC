{
  "hooks": {
    "UserPromptSubmit": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/agentrmc-launch.cmd\" turn-start",
            "name": "agentrmc-notify-turn-start",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/agentrmc-launch.cmd\" permission",
            "name": "agentrmc-notify-permission",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "async": true,
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/agentrmc-launch.cmd\" question",
            "name": "agentrmc-notify-question",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/agentrmc-launch.cmd\" stop",
            "name": "agentrmc-notify-stop",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/agentrmc-launch.cmd\" error",
            "name": "agentrmc-notify-error",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
