{
  "hooks": {
    "PermissionRequest": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/agentrmc-notify.js",
              "permission"
            ],
            "name": "agentrmc-notify-permission",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "async": true,
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/agentrmc-notify.js",
              "question"
            ],
            "name": "agentrmc-notify-question",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "async": true,
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/agentrmc-notify.js",
              "stop"
            ],
            "name": "agentrmc-notify-stop",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
