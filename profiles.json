{
  "_comment": "按前台进程名/窗口标题匹配，命中第一个即用；都不中则用 default",
  "profiles": [
    {
      "name": "browser",
      "match": {
        "process": [
          "chrome.exe",
          "msedge.exe",
          "firefox.exe",
          "brave.exe"
        ]
      },
      "keys": {
        "38": "scroll_up",
        "40": "scroll_down",
        "37": "back",
        "39": "forward",
        "13": "enter",
        "27": "esc",
        "36": "new_tab",
        "93": "menu",
        "122": "fullscreen"
      },
      "actions": {
        "scroll_up": {
          "type": "scroll",
          "delta": 360
        },
        "scroll_down": {
          "type": "scroll",
          "delta": -360
        },
        "back": {
          "type": "key",
          "vk": 37,
          "mods": [
            "alt"
          ]
        },
        "forward": {
          "type": "key",
          "vk": 39,
          "mods": [
            "alt"
          ]
        },
        "enter": {
          "type": "key",
          "vk": 13
        },
        "esc": {
          "type": "key",
          "vk": 27
        },
        "new_tab": {
          "type": "key",
          "vk": 84,
          "mods": [
            "ctrl"
          ]
        },
        "menu": {
          "type": "key",
          "vk": 93
        },
        "fullscreen": {
          "type": "none",
          "note": "原生 F11 直通：不拦截，避免和系统那一次重复触发"
        }
      }
    },
    {
      "name": "editor",
      "match": {
        "process": [
          "code.exe",
          "cursor.exe",
          "windsurf.exe",
          "devenv.exe"
        ]
      },
      "keys": {
        "38": "prev_editor",
        "40": "next_editor",
        "37": "prev_tab",
        "39": "next_tab",
        "13": "enter",
        "27": "esc",
        "36": "palette",
        "93": "menu",
        "122": "fullscreen"
      },
      "actions": {
        "prev_editor": {
          "type": "key",
          "vk": 33,
          "mods": [
            "ctrl"
          ]
        },
        "next_editor": {
          "type": "key",
          "vk": 34,
          "mods": [
            "ctrl"
          ]
        },
        "prev_tab": {
          "type": "key",
          "vk": 9,
          "mods": [
            "ctrl",
            "shift"
          ]
        },
        "next_tab": {
          "type": "key",
          "vk": 9,
          "mods": [
            "ctrl"
          ]
        },
        "enter": {
          "type": "key",
          "vk": 13
        },
        "esc": {
          "type": "key",
          "vk": 27
        },
        "palette": {
          "type": "key",
          "vk": 80,
          "mods": [
            "ctrl",
            "shift"
          ]
        },
        "menu": {
          "type": "key",
          "vk": 93
        },
        "fullscreen": {
          "type": "none",
          "note": "原生 F11 直通：不拦截，避免和系统那一次重复触发"
        }
      }
    },
    {
      "name": "terminal",
      "match": {
        "process": [
          "windowsterminal.exe",
          "cmd.exe",
          "powershell.exe",
          "pwsh.exe",
          "conhost.exe"
        ]
      },
      "keys": {
        "38": "hist_prev",
        "40": "hist_next",
        "37": "word_left",
        "39": "word_right",
        "13": "enter",
        "27": "esc",
        "36": "clear",
        "122": "fullscreen"
      },
      "actions": {
        "hist_prev": {
          "type": "key",
          "vk": 38
        },
        "hist_next": {
          "type": "key",
          "vk": 40
        },
        "word_left": {
          "type": "key",
          "vk": 37,
          "mods": [
            "ctrl"
          ]
        },
        "word_right": {
          "type": "key",
          "vk": 39,
          "mods": [
            "ctrl"
          ]
        },
        "enter": {
          "type": "key",
          "vk": 13
        },
        "esc": {
          "type": "key",
          "vk": 27
        },
        "clear": {
          "type": "key",
          "vk": 76,
          "mods": [
            "ctrl"
          ]
        },
        "fullscreen": {
          "type": "none",
          "note": "原生 F11 直通：不拦截，避免和系统那一次重复触发"
        }
      }
    },
    {
      "name": "qoder",
      "match": {
        "process": [
          "qoder.exe",
          "qoder cn.exe"
        ]
      },
      "keys": {
        "38": "scroll_up",
        "40": "scroll_down",
        "37": "cursor_left",
        "39": "cursor_right",
        "13": "send",
        "27": "back",
        "93": "newline",
        "36": "chat_top",
        "122": "fullscreen"
      },
      "nav": {
        "exit_key": 36,
        "keys": {
          "38": "nav_top",
          "40": "nav_bottom",
          "37": "nav_prev",
          "39": "nav_next"
        }
      },
      "actions": {
        "scroll_up": {
          "type": "scroll",
          "delta": 300,
          "hold_repeat": 100,
          "hold_accel": true
        },
        "scroll_down": {
          "type": "scroll",
          "delta": -300,
          "hold_repeat": 100,
          "hold_accel": true
        },
        "cursor_left": {
          "type": "none",
          "note": "原生 ← 移动光标"
        },
        "cursor_right": {
          "type": "none",
          "note": "原生 → 移动光标"
        },
        "send": {
          "type": "none",
          "note": "原生 Enter 发送"
        },
        "back": {
          "type": "none",
          "note": "原生 Esc 停止/返回"
        },
        "newline": {
          "type": "key",
          "vk": 13,
          "mods": [
            "shift"
          ]
        },
        "fullscreen": {
          "type": "none",
          "note": "原生 F11 直通"
        },
        "nav_top": {
          "type": "key",
          "vk": 33,
          "label": "上翻一页"
        },
        "nav_bottom": {
          "type": "key",
          "vk": 34,
          "label": "下翻一页"
        },
        "nav_prev": {
          "type": "key",
          "vk": 9,
          "mods": [
            "shift"
          ],
          "label": "上一个控件"
        },
        "nav_next": {
          "type": "key",
          "vk": 9,
          "label": "下一个控件"
        },
        "nav_exit": {
          "type": "nav_exit",
          "label": "退出导航"
        },
        "chat_top": {
          "type": "scroll",
          "delta": 9000,
          "repeat": 3,
          "label": "滚到顶",
          "hold_action": {
            "type": "nav_toggle",
            "label": "导航模式"
          },
          "hold_ms": 450,
          "hold_defer": true
        }
      },
      "voice": {
        "hotkey": {
          "mods": [
            "ctrl",
            "shift"
          ],
          "vk": 86,
          "trigger": "toggle"
        }
      }
    },
    {
      "name": "agent",
      "extends": "qoder",
      "match": {
        "process": [
          "workbuddyai.exe",
          "workbuddy.exe"
        ],
        "title": [
          "workbuddy"
        ]
      },
      "voice": {
        "hotkey": {
          "mods": [
            "ctrl"
          ],
          "vk": 68,
          "trigger": "toggle"
        }
      }
    },
    {
      "name": "default",
      "match": {},
      "keys": {
        "38": "up",
        "40": "down",
        "37": "left",
        "39": "right",
        "13": "confirm",
        "27": "back",
        "93": "menu",
        "36": "home",
        "122": "fullscreen"
      },
      "actions": {
        "up": {
          "type": "key",
          "vk": 38
        },
        "down": {
          "type": "key",
          "vk": 40
        },
        "left": {
          "type": "key",
          "vk": 37
        },
        "right": {
          "type": "key",
          "vk": 39
        },
        "confirm": {
          "type": "key",
          "vk": 13
        },
        "back": {
          "type": "key",
          "vk": 27
        },
        "menu": {
          "type": "key",
          "vk": 93
        },
        "home": {
          "type": "none",
          "note": "原生 Home（不再注入 Win，避免弹开始菜单/任务栏）"
        },
        "fullscreen": {
          "type": "none",
          "note": "原生 F11 直通：不拦截，避免和系统那一次重复触发"
        }
      }
    }
  ]
}
