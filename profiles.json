{
  "_comment": "按前台进程名/窗口标题匹配，命中第一个即用；都不中则用 default",
  "profiles": [
    {
      "name": "browser",
      "match": {
        "process": [
          "chrome.exe",
          "msedge.exe",
          "firefox.exe",
          "brave.exe"
        ]
      },
      "keys": {
        "38": "scroll_up",
        "40": "scroll_down",
        "37": "back",
        "39": "forward",
        "13": "enter",
        "27": "esc",
        "36": "new_tab",
        "93": "menu",
        "122": "fullscreen"
      },
      "actions": {
        "scroll_up": {
          "type": "scroll",
          "delta": 360
        },
        "scroll_down": {
          "type": "scroll",
          "delta": -360
        },
        "back": {
          "type": "key",
          "vk": 37,
          "mods": [
            "alt"
          ]
        },
        "forward": {
          "type": "key",
          "vk": 39,
          "mods": [
            "alt"
          ]
        },
        "enter": {
          "type": "key",
          "vk": 13
        },
        "esc": {
          "type": "key",
          "vk": 27
        },
        "new_tab": {
          "type": "key",
          "vk": 84,
          "mods": [
            "ctrl"
          ]
        },
        "menu": {
          "type": "key",
          "vk": 93
        },
        "fullscreen": {
          "type": "none",
          "note": "原生 F11 直通：不拦截，避免和系统那一次重复触发"
        }
      }
    },
    {
      "name": "editor",
